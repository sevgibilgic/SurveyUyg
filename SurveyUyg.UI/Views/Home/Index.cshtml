@{
    ViewData["Title"] = "Home Page";
    Layout = "_LayoutAdmin";
}

<div class="text-center">
    <h1 class="display-4">Anket Verileri (API Test)</h1>
    <hr />

    @if (ViewBag.Data != null)
    {
        <div class="alert alert-success">
            <strong>API'den Gelen Ham Veri:</strong>
            <pre class="text-start mt-3 p-3 bg-light border">@ViewBag.Data</pre>
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            API'den veri alınamadı veya henüz anket yok.
            <br />
            <small>Not: API projesinin <b>7184</b> portunda çalıştığından emin ol.</small>
        </div>
    }
</div>